<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- DeptChat web app (browser). References DeptChat.Shared only, like the mobile app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeptChat.Web.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeptChat.Shared\DeptChat.Shared.csproj" />
  </ItemGroup>

</Project>
