<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DeptChat.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DeptChat.Mobile.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        x:Name="LoginShellContent"
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        x:Name="DepartmentsShellContent"
        Title="Departments"
        ContentTemplate="{DataTemplate views:DepartmentsPage}"
        Route="DepartmentsPage" />

</Shell>
