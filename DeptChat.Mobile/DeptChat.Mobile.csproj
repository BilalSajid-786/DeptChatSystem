<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>DeptChat.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>DeptChat</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.deptchat.mobile</ApplicationId>
		<ApplicationIdGuid>0fb76a7c-18a6-45a4-a136-a0562067589d</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.9</ApplicationDisplayVersion>
		<ApplicationVersion>10</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
		<WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
	</PropertyGroup>

	<!-- Platform Specific Code Exclusions -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android')) != true">
		<Compile Remove="Platforms\Android\**" />
		<None Remove="Platforms\Android\**" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-ios')) != true">
		<Compile Remove="Platforms\iOS\**" />
		<None Remove="Platforms\iOS\**" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-maccatalyst')) != true">
		<Compile Remove="Platforms\MacCatalyst\**" />
		<None Remove="Platforms\MacCatalyst\**" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-tizen')) != true">
		<Compile Remove="Platforms\Tizen\**" />
		<None Remove="Platforms\Tizen\**" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-windows')) != true">
		<Compile Remove="Platforms\Windows\**" />
		<None Remove="Platforms\Windows\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon (WhatsApp Emerald Green) -->
		<MauiIcon Include="Resources\appicon.svg" ForegroundFile="Resources\appiconfg.svg" Color="#25D366" />

		<!-- Splash Screen (WhatsApp Dark Teal) -->
		<MauiSplashScreen Include="Resources\appiconfg.svg" Color="#008069" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DeptChat.Shared\DeptChat.Shared.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.110" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.1" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8" />
	</ItemGroup>
	
<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android')) == true">
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.11.0.1" />
    <GoogleServicesJson Include="Platforms\Android\google-services.json" />
</ItemGroup>




</Project>
