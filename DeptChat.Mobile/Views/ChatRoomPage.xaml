<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeptChat.Mobile.ViewModels"
             x:Class="DeptChat.Mobile.Views.ChatRoomPage"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="#EFEAE2">

    <Grid RowDefinitions="Auto, *">

        <!-- 1. WhatsApp Top App Bar (Clean Header without call or menu buttons) -->
        <Grid Grid.Row="0"
              BackgroundColor="#075E54"
              HeightRequest="60"
              Padding="6,4,12,4"
              ColumnDefinitions="Auto, *">

            <!-- Back Arrow + Contact Avatar + Title -->
            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <!-- Back Button -->
                <Button Text="←"
                        Command="{Binding BackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="24"
                        FontAttributes="Bold"
                        Padding="0"
                        WidthRequest="32"
                        HeightRequest="44"
                        VerticalOptions="Center" />

                <!-- WhatsApp Circular Avatar -->
                <Border BackgroundColor="#00A884"
                        Stroke="White"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 19"
                        WidthRequest="38"
                        HeightRequest="38"
                        VerticalOptions="Center">
                    <Label Text="{Binding AvatarInitial}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="16"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Department / Contact Title & Real-Time Presence Subtitle (WhatsApp Style) -->
                <VerticalStackLayout VerticalOptions="Center" Spacing="1" Margin="4,0,0,0">
                    <Label Text="{Binding ContactTitle}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="16"
                           LineBreakMode="TailTruncation" />

                    <Label Text="{Binding PresenceStatusText}"
                           TextColor="{Binding PresenceTextColor}"
                           IsVisible="{Binding HasPresenceStatus}"
                           FontSize="12"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>

        <!-- 2. Chat Area: WhatsApp Doodle Wallpaper + Messages + Floating Input -->
        <Grid Grid.Row="1">
            <!-- Authentic WhatsApp Doodle Pattern Wallpaper -->
            <Image Source="whatsapp_bg.png"
                   Aspect="AspectFill"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand" />

            <Grid RowDefinitions="Auto, *, Auto">

                <!-- In-App Cross-Department Toast Banner -->
                <Border Grid.Row="0" 
                        IsVisible="{Binding ShowInAppToast}" 
                        BackgroundColor="#1E293B" 
                        Padding="14,8" 
                        Margin="8,4"
                        StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="{Binding InAppToastMessage}" TextColor="White" FontSize="13" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding DismissToastCommand}" BackgroundColor="Transparent" TextColor="#94A3B8" Padding="6,0" HeightRequest="30" />
                    </Grid>
                </Border>

                <!-- Scrollable Messages Canvas -->
                <CollectionView x:Name="MessagesCollectionView"
                                Grid.Row="1"
                                ItemsSource="{Binding Messages}"
                                BackgroundColor="Transparent"
                                Margin="8,4"
                                ItemSizingStrategy="MeasureAllItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageItem">
                            <Grid Padding="0,3" HorizontalOptions="FillAndExpand">
                                <Border HorizontalOptions="{Binding Alignment}"
                                        BackgroundColor="{Binding BubbleColor}"
                                        Stroke="#CBD5E1"
                                        StrokeThickness="0.4"
                                        StrokeShape="{Binding BubbleShape}"
                                        Padding="10,6,10,6"
                                        MaximumWidthRequest="300">

                                    <VerticalStackLayout Spacing="3">
                                        <!-- Sender Name (Only shown on incoming departmental messages) -->
                                        <Label Text="{Binding SenderName}"
                                               FontSize="12"
                                               TextColor="#075E54"
                                               FontAttributes="Bold"
                                               IsVisible="{Binding ShowSenderName}" />

                                        <!-- Regular Text Message -->
                                        <Label Text="{Binding Content}"
                                               FontSize="15"
                                               TextColor="#111B21"
                                               LineBreakMode="WordWrap">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsVoiceMessage}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- WhatsApp Voice Note Player with Draggable Scrubber -->
                                        <Grid ColumnDefinitions="38, *" ColumnSpacing="8" WidthRequest="225" VerticalOptions="Center" Padding="2,2">
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid" Binding="{Binding IsVoiceMessage}" Value="False">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Grid.Triggers>

                                            <!-- Circular Play/Pause Button -->
                                            <Button Grid.Column="0"
                                                    Text="{Binding PlayButtonIcon}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatRoomViewModel}}, Path=TogglePlayVoiceCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{Binding PlayButtonColor}"
                                                    TextColor="White"
                                                    WidthRequest="38"
                                                    HeightRequest="38"
                                                    CornerRadius="19"
                                                    Padding="0"
                                                    FontSize="15"
                                                    FontAttributes="Bold"
                                                    VerticalOptions="Center" />

                                            <!-- Waveform Draggable Scrubber & Duration -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                <!-- Draggable Slider Scrubber -->
                                                <Slider Value="{Binding PlaybackProgress}"
                                                        Minimum="0"
                                                        Maximum="1"
                                                        MinimumTrackColor="#00A884"
                                                        MaximumTrackColor="#CBD5E1"
                                                        ThumbColor="#00A884"
                                                        DragStarted="OnMessageSliderDragStarted"
                                                        DragCompleted="OnMessageSliderDragCompleted"
                                                        HeightRequest="28"
                                                        Margin="0,-3" />

                                                <!-- Duration + Mic Badge -->
                                                <Grid ColumnDefinitions="*, Auto" Margin="4,-2,4,0">
                                                    <Label Grid.Column="0" 
                                                           Text="{Binding CurrentPlaybackTime}" 
                                                           FontSize="11" 
                                                           TextColor="#667781" 
                                                           FontAttributes="Bold" 
                                                           VerticalOptions="Center" />
                                                    <Label Grid.Column="1" 
                                                           Text="🎙️" 
                                                           FontSize="11" 
                                                           TextColor="#34B7F1"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Metadata Footer (Timestamp + WhatsApp Delivery Blue Ticks) -->
                                        <HorizontalStackLayout HorizontalOptions="End" Spacing="3" Margin="4,1,0,0">
                                            <Label Text="{Binding TimeFormatted}" FontSize="11" TextColor="#667781" VerticalOptions="Center" />
                                            <Label Text="{Binding StatusIcon}" 
                                                   TextColor="{Binding StatusColor}" 
                                                   FontSize="11" 
                                                   IsVisible="{Binding IsOutgoing}" 
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- 3. WhatsApp Bottom Input Area (Floating Capsule + Green FAB) -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*, Auto"
                      ColumnSpacing="6"
                      Padding="6,4,6,8"
                      BackgroundColor="Transparent"
                      VerticalOptions="End">

                    <!-- Capsule Pill (1. Normal Text Entry Mode) -->
                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#CBD5E1"
                            StrokeThickness="0.5"
                            StrokeShape="RoundRectangle 24"
                            Padding="6,0,8,0"
                            HeightRequest="48"
                            VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsRecordingVoice}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsVoicePreviewReady}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="2" VerticalOptions="Center">
                            <!-- Emoji Button -->
                            <Button Grid.Column="0"
                                    Text="😊"
                                    BackgroundColor="Transparent"
                                    TextColor="#8696A0"
                                    FontSize="18"
                                    WidthRequest="32"
                                    HeightRequest="40"
                                    Padding="0"
                                    VerticalOptions="Center" />

                            <!-- Message Entry Box -->
                            <Entry Grid.Column="1"
                                   Text="{Binding InputMessage}" 
                                   Placeholder="Message" 
                                   PlaceholderColor="#8696A0" 
                                   TextColor="#111B21"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   HeightRequest="42"
                                   Focused="OnMessageEntryFocused" />

                            <!-- Attachment Paperclip Button -->
                            <Button Grid.Column="2"
                                    Text="📎"
                                    Command="{Binding AttachFileCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#8696A0"
                                    FontSize="18"
                                    WidthRequest="32"
                                    HeightRequest="40"
                                    Padding="0"
                                    VerticalOptions="Center" />

                            <!-- Camera Button -->
                            <Button Grid.Column="3"
                                    Text="📷"
                                    Command="{Binding AttachFileCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#8696A0"
                                    FontSize="17"
                                    WidthRequest="32"
                                    HeightRequest="40"
                                    Padding="0"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Capsule Pill (2. WhatsApp Live Recording Mode: Red dot + Timer + Pause/Listen + Trash) -->
                    <Border Grid.Column="0"
                            BackgroundColor="#FEE2E2"
                            Stroke="#FCA5A5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            Padding="10,0,10,0"
                            HeightRequest="48"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsRecordingVoice}">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="6" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="🔴" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding RecordingDurationText}"
                                   TextColor="#991B1B"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   VerticalOptions="Center" />

                            <!-- Pause & Review Button: Taps this to stop & listen before sending! -->
                            <Button Grid.Column="2"
                                    Text="⏸ Listen"
                                    Command="{Binding PauseAndPreviewVoiceCommand}"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="14"
                                    HeightRequest="30"
                                    Padding="8,0"
                                    VerticalOptions="Center" />

                            <!-- Discard / Trash Button -->
                            <Button Grid.Column="3"
                                    Text="🗑️"
                                    Command="{Binding CancelVoiceRecordingCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#DC2626"
                                    FontSize="18"
                                    WidthRequest="30"
                                    HeightRequest="40"
                                    Padding="0"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Capsule Pill (3. WhatsApp Audio Preview Mode: Trash + Play/Pause + Draggable Scrubber + Timer) -->
                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#CBD5E1"
                            StrokeThickness="0.5"
                            StrokeShape="RoundRectangle 24"
                            Padding="8,0,10,0"
                            HeightRequest="48"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsVoicePreviewReady}">
                        <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="6" VerticalOptions="Center">
                            <!-- Discard / Trash Button -->
                            <Button Grid.Column="0"
                                    Text="🗑️"
                                    Command="{Binding CancelVoiceRecordingCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#EF4444"
                                    FontSize="18"
                                    WidthRequest="30"
                                    HeightRequest="40"
                                    Padding="0"
                                    VerticalOptions="Center" />

                            <!-- Play / Pause Preview Button -->
                            <Button Grid.Column="1"
                                    Text="{Binding VoicePreviewPlayIcon}"
                                    Command="{Binding TogglePlayVoicePreviewCommand}"
                                    BackgroundColor="#00A884"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="16"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    VerticalOptions="Center" />

                            <!-- Draggable Audio Waveform Slider -->
                            <Slider Grid.Column="2"
                                    Value="{Binding VoicePreviewProgress}"
                                    Minimum="0"
                                    Maximum="1"
                                    MinimumTrackColor="#00A884"
                                    MaximumTrackColor="#E2E8F0"
                                    ThumbColor="#00A884"
                                    DragStarted="OnPreviewSliderDragStarted"
                                    DragCompleted="OnPreviewSliderDragCompleted"
                                    VerticalOptions="Center" />

                            <!-- Preview Duration Text -->
                            <Label Grid.Column="3"
                                   Text="{Binding VoicePreviewTimeText}"
                                   TextColor="#475569"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Circular WhatsApp Action FAB -->
                    <!-- 1. Microphone FAB when input is empty, not recording, and not previewing -->
                    <Button Grid.Column="1"
                            Text="🎙️"
                            Command="{Binding StartVoiceRecordingCommand}"
                            BackgroundColor="#00A884"
                            TextColor="White"
                            FontSize="20"
                            CornerRadius="24"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            VerticalOptions="Center">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding HasInputText}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRecordingVoice}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsVoicePreviewReady}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 2. Send Text FAB when input has text and not recording/previewing -->
                    <Button Grid.Column="1"
                            Text="➤"
                            Command="{Binding SendMessageCommand}"
                            BackgroundColor="#00A884"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            VerticalOptions="Center"
                            IsVisible="{Binding HasInputText}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRecordingVoice}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsVoicePreviewReady}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 3. Send Voice FAB when recording or previewing -->
                    <Button Grid.Column="1"
                            Text="➤"
                            Command="{Binding SendVoiceRecordingCommand}"
                            BackgroundColor="#00A884"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            WidthRequest="48"
                            HeightRequest="48"
                            Padding="0"
                            VerticalOptions="Center">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRecordingVoice}" Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsVoicePreviewReady}" Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRecordingVoice}" Value="False">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
