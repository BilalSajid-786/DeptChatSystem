<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeptChat.Mobile.ViewModels"
             x:Class="DeptChat.Mobile.Views.DepartmentConversationsPage"
             Title="{Binding DepartmentName}"
             BackgroundColor="#F8FAFC">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding LoadConversationsCommand}" />
        <ToolbarItem Text="Log Out" Command="{Binding LogoutCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header Banner -->
        <Border Grid.Row="0" BackgroundColor="#1E293B" Padding="16,14" StrokeThickness="0">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <!-- Back Button -->
                    <Button Grid.Column="0"
                            Text="← Back"
                            Command="{Binding BackCommand}"
                            BackgroundColor="#334155"
                            TextColor="White"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="36"
                            Padding="12,0"
                            VerticalOptions="Center" />

                    <!-- Title & Subtitle -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding DepartmentName}" TextColor="White" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding SubtitleText}" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2"
                            Text="🔄"
                            Command="{Binding LoadConversationsCommand}"
                            BackgroundColor="#334155"
                            TextColor="White"
                            FontSize="14"
                            CornerRadius="8"
                            HeightRequest="36"
                            WidthRequest="36"
                            Padding="0"
                            VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Search Bar (For Admins & Managers to quickly find users or messages) -->
        <Border Grid.Row="1"
                IsVisible="{Binding ShowSearchBar}"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Margin="16,10,16,4"
                Padding="12,0"
                HeightRequest="46"
                VerticalOptions="Center">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0" 
                       Text="🔍" 
                       FontSize="15" 
                       TextColor="#94A3B8" 
                       VerticalOptions="Center" />
                
                <Entry Grid.Column="1"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       Placeholder="Search users or messages..."
                       PlaceholderColor="#94A3B8"
                       TextColor="#0F172A"
                       FontSize="14"
                       ClearButtonVisibility="Never"
                       VerticalOptions="Center"
                       HeightRequest="42" />

                <Button Grid.Column="2"
                        Text="✕"
                        Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding HasSearchQuery}"
                        BackgroundColor="Transparent"
                        TextColor="#64748B"
                        FontSize="14"
                        WidthRequest="30"
                        HeightRequest="36"
                        Padding="0"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="2">
            <!-- 1. In-App Cross-Department Toast Banner -->
            <Border VerticalOptions="Start"
                    ZIndex="10"
                    IsVisible="{Binding ShowInAppToast}" 
                    BackgroundColor="#1E293B" 
                    Padding="16,10" 
                    Margin="12,8"
                    StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="{Binding InAppToastMessage}" TextColor="White" FontSize="13" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="✕" Command="{Binding DismissToastCommand}" BackgroundColor="Transparent" TextColor="#94A3B8" Padding="6,0" HeightRequest="30" />
                </Grid>
            </Border>

            <!-- Loading Indicator -->
            <VerticalStackLayout IsVisible="{Binding IsBusy}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12"
                                 Padding="32">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="#0284C7"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Center" />
                <Label Text="Loading conversations..."
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#64748B"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Empty State (No chats exist in this department) -->
            <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12"
                                 Padding="32">
                <Border BackgroundColor="#E2E8F0" StrokeShape="RoundRectangle 40" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                    <Label Text="📭" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="No Customer Conversations Yet"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalOptions="Center" />
                <Label Text="When users send inquiries to this department, their chat rooms will appear here live."
                       FontSize="13"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Search Results Empty State (Search filter matched nothing) -->
            <VerticalStackLayout IsVisible="{Binding IsSearchEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12"
                                 Padding="32">
                <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 36" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center">
                    <Label Text="🔍" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="No Users Found"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalOptions="Center" />
                <Label Text="No user conversations match your search query."
                       FontSize="13"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />
                <Button Text="Clear Search"
                        Command="{Binding ClearSearchCommand}"
                        BackgroundColor="#0284C7"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="16,0"
                        Margin="0,4,0,0"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Conversations List -->
            <CollectionView IsVisible="{Binding HasConversations}"
                            ItemsSource="{Binding Conversations}"
                            Margin="16,8,16,12">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConversationListItem">
                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Margin="0,5" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentConversationsViewModel}}, Path=SelectConversationCommand}" 
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="46, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- User Avatar + Online Indicator Dot -->
                                <Grid Grid.Column="0" WidthRequest="46" HeightRequest="46">
                                    <Border BackgroundColor="#E0F2FE" 
                                            Stroke="#BAE6FD"
                                            StrokeShape="RoundRectangle 23" 
                                            WidthRequest="46" 
                                            HeightRequest="46" 
                                            HorizontalOptions="Center" 
                                            VerticalOptions="Center">
                                        <Label Text="{Binding UserInitials}" 
                                               FontSize="18" 
                                               FontAttributes="Bold" 
                                               TextColor="#0284C7" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Green Online Status Indicator Dot -->
                                    <Border IsVisible="{Binding IsOnline}"
                                            BackgroundColor="#22C55E"
                                            Stroke="White"
                                            StrokeThickness="1.5"
                                            StrokeShape="RoundRectangle 6"
                                            WidthRequest="12"
                                            HeightRequest="12"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            Margin="0,0,1,1" />
                                </Grid>

                                <!-- User Name, Last Message, Timestamp -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" 
                                               Text="{Binding CreatedByUserName}" 
                                               FontSize="15" 
                                               FontAttributes="Bold" 
                                               TextColor="#0F172A" 
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" 
                                               Text="{Binding TimeFormatted}" 
                                               FontSize="11" 
                                               TextColor="#94A3B8" 
                                               HorizontalOptions="End" />
                                    </Grid>

                                    <Label Text="{Binding LastMessagePreview}" 
                                           FontSize="13" 
                                           TextColor="#64748B" 
                                           LineBreakMode="TailTruncation" 
                                           MaxLines="1" />
                                </VerticalStackLayout>

                                <!-- Unread Badge & Chevron -->
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Border IsVisible="{Binding HasUnread}"
                                            BackgroundColor="#EF4444" 
                                            StrokeShape="RoundRectangle 10" 
                                            Padding="7,2" 
                                            VerticalOptions="Center">
                                        <Label Text="{Binding UnreadCount}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                    <Label Text="›" FontSize="20" TextColor="#CBD5E1" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
