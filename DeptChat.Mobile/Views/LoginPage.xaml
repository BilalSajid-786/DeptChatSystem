<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeptChat.Mobile.ViewModels"
             x:Class="DeptChat.Mobile.Views.LoginPage"
             BackgroundColor="#F0F2F5"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,32" Spacing="18" VerticalOptions="Center">
            
            <!-- App Icon & Title (WhatsApp Green Branding) -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Frame BackgroundColor="#25D366" CornerRadius="32" HeightRequest="68" WidthRequest="68" Padding="0" HasShadow="True" HorizontalOptions="Center" BorderColor="Transparent">
                    <Label Text="💬" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <Label Text="Department Chat"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#111B21"
                       HorizontalOptions="Center" />
                <Label Text="Direct real-time support • Zero ticket queues"
                       FontSize="13"
                       TextColor="#667781"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Login Card Form -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="14">

                    <!-- Error Alert -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#EF4444"
                           FontSize="12"
                           FontAttributes="Bold"
                           IsVisible="{Binding HasError}"
                           HorizontalOptions="Center" />

                    <!-- Email Address or Phone (Identifier) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding IdentifierLabel}" TextColor="#475569" FontSize="12" FontAttributes="Bold" />
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,2" Stroke="#CBD5E1">
                            <Entry Text="{Binding Email}" BackgroundColor="Transparent" TextColor="#0F172A" Placeholder="{Binding IdentifierPlaceholder}" PlaceholderColor="#94A3B8" HeightRequest="40" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Password" TextColor="#475569" FontSize="12" FontAttributes="Bold" />
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,2" Stroke="#CBD5E1">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Entry Grid.Column="0"
                                       Text="{Binding Password}"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F172A"
                                       IsPassword="{Binding IsPasswordHidden}"
                                       Placeholder="••••••••"
                                       PlaceholderColor="#94A3B8"
                                       HeightRequest="40"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding PasswordToggleIcon}"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#64748B"
                                        FontSize="16"
                                        Padding="6,0"
                                        HeightRequest="38"
                                        WidthRequest="40"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Submit Button (WhatsApp Green) -->
                    <Button Text="{Binding SubmitButtonText}"
                            Command="{Binding SubmitCommand}"
                            BackgroundColor="#25D366"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="10"
                            HeightRequest="48"
                            Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
