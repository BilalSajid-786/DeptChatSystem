<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeptChat.Mobile.ViewModels"
             x:Class="DeptChat.Mobile.Views.DepartmentsPage"
             Title="Departments"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F2F5">

    <Grid RowDefinitions="Auto, *">
        <!-- WhatsApp Header Banner with User Info, Add Dept Button & Exit Button -->
        <Border Grid.Row="0" BackgroundColor="#008069" Padding="18,14" StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🏢" FontSize="15" VerticalOptions="Center" />
                            <Label Text="{Binding ClientDisplayName}" TextColor="#A7F3D0" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="Support Channels" TextColor="White" FontSize="20" FontAttributes="Bold" />
                        <Label Text="Select a department to start chatting directly" TextColor="#D1FAE5" FontSize="12" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <!-- Profile Button -->
                        <Button Text="👤 Profile"
                                Command="{Binding OpenProfileModalCommand}"
                                BackgroundColor="#005C4B"
                                BorderColor="#00A884"
                                BorderWidth="1"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="36"
                                Padding="10,0"
                                VerticalOptions="Center" />

                        <!-- WhatsApp Styled Exit Button -->
                        <Button Text="🚪 Exit"
                                Command="{Binding LogoutCommand}"
                                BackgroundColor="#005C4B"
                                BorderColor="#00A884"
                                BorderWidth="1"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="36"
                                Padding="10,0"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Current User Details Badge -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Border BackgroundColor="#005C4B" Stroke="#00A884" StrokeShape="RoundRectangle 6" Padding="8,4" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenProfileModalCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding UserBadge}" TextColor="#72E5BE" FontSize="11" FontAttributes="Bold" />
                    </Border>
                    <Label Text="{Binding CurrentUserEmail}" TextColor="#D1FAE5" FontSize="11" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Main Content Area: WhatsApp Action Card + Department List -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *">
            <!-- Admin Quick Action: Add Department (WhatsApp White & Green Card) -->
            <Border Grid.Row="0"
                    IsVisible="{Binding IsAdmin}"
                    BackgroundColor="White"
                    Stroke="#C8E6C9"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Margin="16,12,16,4"
                    Padding="14,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenAddDepartmentModalCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border BackgroundColor="#25D366" StrokeShape="RoundRectangle 21" WidthRequest="42" HeightRequest="42" VerticalOptions="Center">
                        <Label Text="➕" FontSize="18" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Add New Department" FontSize="15" FontAttributes="Bold" TextColor="#111B21" />
                        <Label Text="Create channel visible to all users &amp; managers" FontSize="11" TextColor="#008069" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="➔" FontSize="18" FontAttributes="Bold" TextColor="#008069" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Department Cards List -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding Departments}" Margin="16,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DepartmentItem">
                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Margin="0,5" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentsViewModel}}, Path=SelectDepartmentCommand}" 
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="46, *, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- Department Icon Avatar (WhatsApp Green Pastel Circle) -->
                                <Border Grid.Column="0" BackgroundColor="#E7F8F0" StrokeShape="RoundRectangle 23" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{Binding Icon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <!-- Name & Description -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#111B21" />
                                    <Label Text="{Binding Description}" FontSize="12" TextColor="#667781" LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>

                                <!-- WhatsApp Emerald Green Unread Badge Counter -->
                                <Border Grid.Column="2" 
                                        IsVisible="{Binding HasUnread}"
                                        BackgroundColor="#25D366" 
                                        StrokeShape="RoundRectangle 12" 
                                        Padding="8,2" 
                                        VerticalOptions="Center">
                                    <Label Text="{Binding UnreadCount}" TextColor="White" FontSize="11" FontAttributes="Bold" />
                                </Border>

                                <!-- Admin Delete Department Button -->
                                <Button Grid.Column="3"
                                        Text="🗑️"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentsViewModel}}, Path=DeleteDepartmentCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentsViewModel}}, Path=IsAdmin}"
                                        BackgroundColor="Transparent"
                                        TextColor="#94A3B8"
                                        FontSize="16"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading Indicator Overlay -->
            <ActivityIndicator Grid.Row="1"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#008069"
                               WidthRequest="40"
                               HeightRequest="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <!-- Add Department Modal Overlay (Admin Only) -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsAddDepartmentModalVisible}"
              BackgroundColor="#99000000"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              ZIndex="999">
            <Border BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    WidthRequest="340"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="24"
                    Margin="20">
                <VerticalStackLayout Spacing="16">
                    <!-- Title & Close Button -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="➕ New Department" FontSize="18" FontAttributes="Bold" TextColor="#111B21" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseAddDepartmentModalCommand}"
                                BackgroundColor="Transparent" TextColor="#64748B" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" />
                    </Grid>

                    <Label Text="Add a new department channel. By default, it will be visible to all users and managers."
                           FontSize="12" TextColor="#64748B" />

                    <!-- Department Name Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Department Name *" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry Text="{Binding NewDepartmentName}"
                                   Placeholder="e.g. Logistics, Sales, HR"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#0F172A"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Department Description Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Description" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Editor Text="{Binding NewDepartmentDescription}"
                                    Placeholder="Describe the department channel..."
                                    PlaceholderColor="#94A3B8"
                                    TextColor="#0F172A"
                                    FontSize="14"
                                    HeightRequest="75"
                                    AutoSize="Disabled" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Label Text="{Binding AddDepartmentErrorMessage}"
                           TextColor="#EF4444"
                           FontSize="12"
                           IsVisible="{Binding HasAddDepartmentError}" />

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,6,0,0">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                Command="{Binding CloseAddDepartmentModalCommand}"
                                BackgroundColor="#F1F5F9"
                                TextColor="#475569"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="8"
                                HeightRequest="42" />
                        <Button Grid.Column="1"
                                Text="Create"
                                Command="{Binding CreateDepartmentCommand}"
                                IsEnabled="{Binding CanSaveDepartment}"
                                BackgroundColor="#008069"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="8"
                                HeightRequest="42" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- User Profile Modal Overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsProfileModalVisible}"
              BackgroundColor="#99000000"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="FillAndExpand"
              ZIndex="1000">
            <Border BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    WidthRequest="340"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22"
                    Margin="20">
                <VerticalStackLayout Spacing="14">
                    <!-- Title & Close Button -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="👤 My Profile" FontSize="18" FontAttributes="Bold" TextColor="#111B21" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseProfileModalCommand}"
                                BackgroundColor="Transparent" TextColor="#64748B" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" />
                    </Grid>

                    <!-- Organization Info Banner -->
                    <Border BackgroundColor="#E8F5E9" Stroke="#A5D6A7" StrokeShape="RoundRectangle 8" Padding="10,6">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🏢" FontSize="14" VerticalOptions="Center" />
                            <Label Text="{Binding ClientDisplayName}" FontSize="12" FontAttributes="Bold" TextColor="#1B5E20" VerticalOptions="Center" />
                            <Label Text="•" FontSize="12" TextColor="#66BB6A" VerticalOptions="Center" />
                            <Label Text="{Binding CurrentUserRole}" FontSize="12" TextColor="#2E7D32" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Email (Read Only) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email Address" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F1F5F9" Padding="12,4">
                            <Label Text="{Binding CurrentUserEmail}" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Full Name (Editable) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Full Name *" FontSize="11" FontAttributes="Bold" TextColor="#334155" />
                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry Text="{Binding EditFullName}"
                                   Placeholder="Full Name"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#0F172A"
                                   FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Phone Number (Editable) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Phone Number" FontSize="11" FontAttributes="Bold" TextColor="#334155" />
                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry Text="{Binding EditPhoneNumber}"
                                   Placeholder="+1 (555) 000-0000"
                                   PlaceholderColor="#94A3B8"
                                   Keyboard="Telephone"
                                   TextColor="#0F172A"
                                   FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Address (Editable) -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Address" FontSize="11" FontAttributes="Bold" TextColor="#334155" />
                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry Text="{Binding EditAddress}"
                                   Placeholder="Street, City, Country"
                                   PlaceholderColor="#94A3B8"
                                   TextColor="#0F172A"
                                   FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Label Text="{Binding ProfileErrorMessage}"
                           TextColor="#EF4444"
                           FontSize="12"
                           IsVisible="{Binding HasProfileError}" />

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                Command="{Binding CloseProfileModalCommand}"
                                BackgroundColor="#F1F5F9"
                                TextColor="#475569"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="8"
                                HeightRequest="40" />
                        <Button Grid.Column="1"
                                Text="Save"
                                Command="{Binding SaveProfileCommand}"
                                IsEnabled="{Binding CanSaveProfile}"
                                BackgroundColor="#008069"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="8"
                                HeightRequest="40" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
