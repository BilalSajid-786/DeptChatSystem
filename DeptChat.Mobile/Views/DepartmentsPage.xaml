<?xml version="1.0" encoding="utf-8" ?>



<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"



             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"



             xmlns:vm="clr-namespace:DeptChat.Mobile.ViewModels"



             x:Class="DeptChat.Mobile.Views.DepartmentsPage"



             Title="Departments"



             Shell.NavBarIsVisible="False"



             BackgroundColor="#F0F2F5">







    <Grid RowDefinitions="Auto, *">



        <!-- WhatsApp Header Banner with User Info, Add Dept Button & Exit Button -->



        <Border Grid.Row="0" BackgroundColor="#008069" Padding="18,14" StrokeThickness="0">



            <VerticalStackLayout Spacing="10">



                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">



                    <VerticalStackLayout Grid.Column="0" Spacing="2">



                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">



                            <Label Text="🏢" FontSize="15" VerticalOptions="Center" />



                            <Label Text="{Binding ClientDisplayName}" TextColor="#A7F3D0" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />



                        </HorizontalStackLayout>



                        <Label Text="Support Channels" TextColor="White" FontSize="20" FontAttributes="Bold" />



                        <Label Text="Select a department to start chatting directly" TextColor="#D1FAE5" FontSize="12" />



                    </VerticalStackLayout>







                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">



                        <!-- Profile Button -->



                        <Button Text="👤 Profile"



                                Command="{Binding OpenProfileModalCommand}"



                                BackgroundColor="#005C4B"



                                BorderColor="#00A884"



                                BorderWidth="1"



                                TextColor="White"



                                FontAttributes="Bold"



                                FontSize="12"



                                CornerRadius="8"



                                HeightRequest="36"



                                Padding="10,0"



                                VerticalOptions="Center" />







                        <!-- WhatsApp Styled Exit Button -->



                        <Button Text="🚪 Exit"



                                Command="{Binding LogoutCommand}"



                                BackgroundColor="#005C4B"



                                BorderColor="#00A884"



                                BorderWidth="1"



                                TextColor="White"



                                FontAttributes="Bold"



                                FontSize="12"



                                CornerRadius="8"



                                HeightRequest="36"



                                Padding="10,0"



                                VerticalOptions="Center" />



                    </HorizontalStackLayout>



                </Grid>







                <!-- Current User Details Badge -->



                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">



                    <Border BackgroundColor="#005C4B" Stroke="#00A884" StrokeShape="RoundRectangle 6" Padding="8,4" StrokeThickness="1">



                        <Border.GestureRecognizers>



                            <TapGestureRecognizer Command="{Binding OpenProfileModalCommand}" />



                        </Border.GestureRecognizers>



                        <Label Text="{Binding UserBadge}" TextColor="#72E5BE" FontSize="11" FontAttributes="Bold" />



                    </Border>



                    <Label Text="{Binding CurrentUserEmail}" TextColor="#D1FAE5" FontSize="11" VerticalOptions="Center" />



                </HorizontalStackLayout>



            </VerticalStackLayout>



        </Border>







        <!-- Main Content Area: WhatsApp Action Card + Department List -->



        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">

            <!-- Incoming Shared Receipt Banner -->
            <Border Grid.Row="0"
                    IsVisible="{Binding IsShareModeBanner}"
                    BackgroundColor="#075E54"
                    Stroke="#00A884"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Margin="16,8,16,4"
                    Padding="12,10">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 8"
                            WidthRequest="38"
                            HeightRequest="38"
                            BackgroundColor="#128C7E">
                        <Label Text="📎" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="Receipt ready to share" TextColor="White" FontAttributes="Bold" FontSize="13" />
                        <Label Text="Tap a department below to send this receipt" TextColor="#D1FAE5" FontSize="11" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Text="✕"
                            Command="{Binding CancelShareModeCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            Padding="0"
                            WidthRequest="32"
                            HeightRequest="32" />
                </Grid>
            </Border>



            <!-- Admin Quick Actions: Add Department, Add User & Manage Accounts (WhatsApp Cards) -->



            <Grid Grid.Row="0"



                  IsVisible="{Binding IsAdmin}"



                  ColumnDefinitions="*, *, *"



                  ColumnSpacing="8"



                  Margin="16,12,16,4">



                



                <!-- Add Department Card -->



                <Border Grid.Column="0"



                        BackgroundColor="White"



                        Stroke="#C8E6C9"



                        StrokeThickness="1"



                        StrokeShape="RoundRectangle 12"



                        Padding="12,10">



                    <Border.GestureRecognizers>



                        <TapGestureRecognizer Command="{Binding OpenAddDepartmentModalCommand}" />



                    </Border.GestureRecognizers>



                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">



                        <Border BackgroundColor="#25D366" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">



                            <Label Text="➕" FontSize="15" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />



                        </Border>



                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">



                            <Label Text="Department" FontSize="13" FontAttributes="Bold" TextColor="#111B21" />



                            <Label Text="Add channel" FontSize="10" TextColor="#008069" FontAttributes="Bold" />



                        </VerticalStackLayout>



                    </Grid>



                </Border>







                <!-- Add User Card -->



                <Border Grid.Column="1"



                        BackgroundColor="White"



                        Stroke="#C8E6C9"



                        StrokeThickness="1"



                        StrokeShape="RoundRectangle 12"



                        Padding="12,10">



                    <Border.GestureRecognizers>



                        <TapGestureRecognizer Command="{Binding OpenAddUserModalCommand}" />



                    </Border.GestureRecognizers>



                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">



                        <Border BackgroundColor="#008069" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">



                            <Label Text="👤⁺" FontSize="15" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />



                        </Border>



                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">



                            <Label Text="Add User" FontSize="13" FontAttributes="Bold" TextColor="#111B21" />



                            <Label Text="Staff / Manager" FontSize="10" TextColor="#008069" FontAttributes="Bold" />



                        </VerticalStackLayout>



                    </Grid>



                </Border>

                <!-- Manage Accounts Card -->

                <Border Grid.Column="2"

                        BackgroundColor="White"

                        Stroke="#C8E6C9"

                        StrokeThickness="1"

                        StrokeShape="RoundRectangle 12"

                        Padding="8,8">

                    <Border.GestureRecognizers>

                        <TapGestureRecognizer Command="{Binding OpenManageAccountsModalCommand}" />

                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6" VerticalOptions="Center">

                        <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 16" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">

                            <Label Text="🛡️" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">

                            <Label Text="Accounts" FontSize="12" FontAttributes="Bold" TextColor="#111B21" LineBreakMode="TailTruncation" />

                            <Label Text="Security" FontSize="10" TextColor="#008069" FontAttributes="Bold" LineBreakMode="TailTruncation" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </Grid>







            <!-- Department Cards List -->



            <CollectionView Grid.Row="2" ItemsSource="{Binding Departments}" Margin="16,8">



                <CollectionView.ItemTemplate>



                    <DataTemplate x:DataType="vm:DepartmentItem">



                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Margin="0,5" Padding="14,12">



                            <Border.GestureRecognizers>



                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentsViewModel}}, Path=SelectDepartmentCommand}" 



                                                      CommandParameter="{Binding .}" />



                            </Border.GestureRecognizers>







                            <Grid ColumnDefinitions="46, *, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">



                                <!-- Department Icon Avatar (WhatsApp Green Pastel Circle) -->



                                <Border Grid.Column="0" BackgroundColor="#E7F8F0" StrokeShape="RoundRectangle 23" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" VerticalOptions="Center">



                                    <Label Text="{Binding Icon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />



                                </Border>







                                                                <!-- Name & WhatsApp Subtitle (Sender + Preview or Description) -->

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">

                                    <Grid ColumnDefinitions="*, Auto">

                                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#111B21" LineBreakMode="TailTruncation" />

                                        <Label Grid.Column="1" Text="{Binding TimeFormatted}" IsVisible="{Binding HasRecentMessage}" FontSize="11" TextColor="{Binding TimestampColor}" HorizontalOptions="End" VerticalOptions="Center" />

                                    </Grid>

                                    <Label Text="{Binding SubtitleText}" FontSize="12.5" TextColor="{Binding SubtitleTextColor}" FontAttributes="{Binding SubtitleFontAttributes}" LineBreakMode="TailTruncation" MaxLines="1" />

                                </VerticalStackLayout>



                                <!-- WhatsApp Emerald Green Unread Badge Counter -->

                                <Border Grid.Column="2" 

                                        IsVisible="{Binding HasUnread}"

                                        BackgroundColor="#25D366" 

                                        StrokeShape="RoundRectangle 12" 

                                        Padding="7,2" 

                                        VerticalOptions="Center">

                                    <Label Text="{Binding UnreadCount}" TextColor="White" FontSize="11" FontAttributes="Bold" />

                                </Border>







                                <!-- Admin Delete Department Button -->



                                <Button Grid.Column="3"



                                        Text="🗑️"



                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentsViewModel}}, Path=DeleteDepartmentCommand}"



                                        CommandParameter="{Binding .}"



                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentsViewModel}}, Path=IsAdmin}"



                                        BackgroundColor="Transparent"



                                        TextColor="#94A3B8"



                                        FontSize="16"



                                        WidthRequest="36"



                                        HeightRequest="36"



                                        Padding="0"



                                        VerticalOptions="Center" />



                            </Grid>



                        </Border>



                    </DataTemplate>



                </CollectionView.ItemTemplate>



            </CollectionView>







            <!-- Loading Indicator Overlay -->



            <ActivityIndicator Grid.Row="2"



                               IsRunning="{Binding IsBusy}"



                               IsVisible="{Binding IsBusy}"



                               Color="#008069"



                               WidthRequest="40"



                               HeightRequest="40"



                               HorizontalOptions="Center"



                               VerticalOptions="Center" />



        </Grid>







        <!-- Add Department Modal Overlay (Admin Only) -->



        <Grid Grid.RowSpan="2"



              IsVisible="{Binding IsAddDepartmentModalVisible}"



              BackgroundColor="#99000000"



              HorizontalOptions="FillAndExpand"



              VerticalOptions="FillAndExpand"



              ZIndex="999">



            <Border BackgroundColor="White"



                    Stroke="#CBD5E1"



                    StrokeThickness="1"



                    StrokeShape="RoundRectangle 16"



                    WidthRequest="340"



                    HorizontalOptions="Center"



                    VerticalOptions="Center"



                    Padding="24"



                    Margin="20">



                <VerticalStackLayout Spacing="16">



                    <!-- Title & Close Button -->



                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">



                        <Label Text="➕ New Department" FontSize="18" FontAttributes="Bold" TextColor="#111B21" VerticalOptions="Center" />



                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseAddDepartmentModalCommand}"



                                BackgroundColor="Transparent" TextColor="#64748B" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" />



                    </Grid>







                    <Label Text="Add a new department channel. By default, it will be visible to all users and managers."



                           FontSize="12" TextColor="#64748B" />







                    <!-- Department Name Input -->



                    <VerticalStackLayout Spacing="6">



                        <Label Text="Department Name *" FontSize="12" FontAttributes="Bold" TextColor="#334155" />



                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                            <Entry Text="{Binding NewDepartmentName}"



                                   Placeholder="e.g. Logistics, Sales, HR"



                                   PlaceholderColor="#94A3B8"



                                   TextColor="#0F172A"



                                   FontSize="14" />



                        </Border>



                    </VerticalStackLayout>







                    <!-- Department Description Input -->



                    <VerticalStackLayout Spacing="6">



                        <Label Text="Description" FontSize="12" FontAttributes="Bold" TextColor="#334155" />



                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                            <Editor Text="{Binding NewDepartmentDescription}"



                                    Placeholder="Describe the department channel..."



                                    PlaceholderColor="#94A3B8"



                                    TextColor="#0F172A"



                                    FontSize="14"



                                    HeightRequest="75"



                                    AutoSize="Disabled" />



                        </Border>



                    </VerticalStackLayout>







                    <!-- Error Message -->



                    <Label Text="{Binding AddDepartmentErrorMessage}"



                           TextColor="#EF4444"



                           FontSize="12"



                           IsVisible="{Binding HasAddDepartmentError}" />







                    <!-- Action Buttons -->



                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,6,0,0">



                        <Button Grid.Column="0"



                                Text="Cancel"



                                Command="{Binding CloseAddDepartmentModalCommand}"



                                BackgroundColor="#F1F5F9"



                                TextColor="#475569"



                                FontAttributes="Bold"



                                FontSize="13"



                                CornerRadius="8"



                                HeightRequest="42" />



                        <Button Grid.Column="1"



                                Text="Create"



                                Command="{Binding CreateDepartmentCommand}"



                                IsEnabled="{Binding CanSaveDepartment}"



                                BackgroundColor="#008069"



                                TextColor="White"



                                FontAttributes="Bold"



                                FontSize="13"



                                CornerRadius="8"



                                HeightRequest="42" />



                    </Grid>



                </VerticalStackLayout>



            </Border>



        </Grid>







        <!-- User Profile Modal Overlay -->



        <Grid Grid.RowSpan="2"



              IsVisible="{Binding IsProfileModalVisible}"



              BackgroundColor="#99000000"



              HorizontalOptions="FillAndExpand"



              VerticalOptions="FillAndExpand"



              ZIndex="1000">



            <Border BackgroundColor="White"



                    Stroke="#CBD5E1"



                    StrokeThickness="1"



                    StrokeShape="RoundRectangle 16"



                    WidthRequest="340"



                    HorizontalOptions="Center"



                    VerticalOptions="Center"



                    Padding="22"



                    Margin="20">



                <VerticalStackLayout Spacing="14">



                    <!-- Title & Close Button -->



                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">



                        <Label Text="👤 My Profile" FontSize="18" FontAttributes="Bold" TextColor="#111B21" VerticalOptions="Center" />



                        <Button Grid.Column="1" Text="✕" Command="{Binding CloseProfileModalCommand}"



                                BackgroundColor="Transparent" TextColor="#64748B" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" />



                    </Grid>







                    <!-- Organization Info Banner -->



                    <Border BackgroundColor="#E8F5E9" Stroke="#A5D6A7" StrokeShape="RoundRectangle 8" Padding="10,6">



                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">



                            <Label Text="🏢" FontSize="14" VerticalOptions="Center" />



                            <Label Text="{Binding ClientDisplayName}" FontSize="12" FontAttributes="Bold" TextColor="#1B5E20" VerticalOptions="Center" />



                            <Label Text="•" FontSize="12" TextColor="#66BB6A" VerticalOptions="Center" />



                            <Label Text="{Binding CurrentUserRole}" FontSize="12" TextColor="#2E7D32" VerticalOptions="Center" />



                        </HorizontalStackLayout>



                    </Border>







                    <!-- Email (Read Only) -->



                    <VerticalStackLayout Spacing="4">



                        <Label Text="Email Address" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />



                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F1F5F9" Padding="12,4">



                            <Label Text="{Binding CurrentUserEmail}" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />



                        </Border>



                    </VerticalStackLayout>







                    <!-- Full Name (Editable) -->



                    <VerticalStackLayout Spacing="4">



                        <Label Text="Full Name *" FontSize="11" FontAttributes="Bold" TextColor="#334155" />



                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                            <Entry Text="{Binding EditFullName}"



                                   Placeholder="Full Name"



                                   PlaceholderColor="#94A3B8"



                                   TextColor="#0F172A"



                                   FontSize="13" />



                        </Border>



                    </VerticalStackLayout>







                    <!-- Phone Number (Editable) -->



                    <VerticalStackLayout Spacing="4">



                        <Label Text="Phone Number" FontSize="11" FontAttributes="Bold" TextColor="#334155" />



                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                            <Entry Text="{Binding EditPhoneNumber}"



                                   Placeholder="+1 (555) 000-0000"



                                   PlaceholderColor="#94A3B8"



                                   Keyboard="Telephone"



                                   TextColor="#0F172A"



                                   FontSize="13" />



                        </Border>



                    </VerticalStackLayout>







                    <!-- Address (Editable) -->



                    <VerticalStackLayout Spacing="4">



                        <Label Text="Address" FontSize="11" FontAttributes="Bold" TextColor="#334155" />



                        <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                            <Entry Text="{Binding EditAddress}"



                                   Placeholder="Street, City, Country"



                                   PlaceholderColor="#94A3B8"



                                   TextColor="#0F172A"



                                   FontSize="13" />



                        </Border>



                    </VerticalStackLayout>







                    <!-- Error Message -->



                    <Label Text="{Binding ProfileErrorMessage}"



                           TextColor="#EF4444"



                           FontSize="12"



                           IsVisible="{Binding HasProfileError}" />







                    <!-- Action Buttons -->



                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,4,0,0">



                        <Button Grid.Column="0"



                                Text="Cancel"



                                Command="{Binding CloseProfileModalCommand}"



                                BackgroundColor="#F1F5F9"



                                TextColor="#475569"



                                FontAttributes="Bold"



                                FontSize="13"



                                CornerRadius="8"



                                HeightRequest="40" />



                        <Button Grid.Column="1"



                                Text="Save"



                                Command="{Binding SaveProfileCommand}"



                                IsEnabled="{Binding CanSaveProfile}"



                                BackgroundColor="#008069"



                                TextColor="White"



                                FontAttributes="Bold"



                                FontSize="13"



                                CornerRadius="8"



                                HeightRequest="40" />



                    </Grid>



                </VerticalStackLayout>



            </Border>



        </Grid>



            <!-- Admin Add User Modal Overlay -->



        <Grid Grid.RowSpan="2"



              IsVisible="{Binding IsAddUserModalVisible}"



              BackgroundColor="#99000000"



              HorizontalOptions="FillAndExpand"



              VerticalOptions="FillAndExpand"



              ZIndex="1000">



            <Border BackgroundColor="White"



                    Stroke="#CBD5E1"



                    StrokeThickness="1"



                    StrokeShape="RoundRectangle 16"



                    WidthRequest="340"



                    MaximumHeightRequest="580"



                    HorizontalOptions="Center"



                    VerticalOptions="Center"



                    Padding="20"



                    Margin="16">



                <ScrollView>



                    <VerticalStackLayout Spacing="12">



                        <!-- Title & Close Button -->



                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">



                            <VerticalStackLayout Grid.Column="0" Spacing="2">



                                <Label Text="👤 Add New User" FontSize="17" FontAttributes="Bold" TextColor="#111B21" />



                                <Label Text="{Binding ClientDisplayName}" FontSize="11" TextColor="#008069" FontAttributes="Bold" />



                            </VerticalStackLayout>



                            <Button Grid.Column="1" Text="✕" Command="{Binding CloseAddUserModalCommand}"



                                    BackgroundColor="Transparent" TextColor="#64748B" FontSize="16" WidthRequest="36" HeightRequest="36" Padding="0" />



                        </Grid>







                        <!-- Role Selector Segment / Chips -->



                        <VerticalStackLayout Spacing="4">



                            <Label Text="Role / Account Type *" FontSize="11" FontAttributes="Bold" TextColor="#475569" />



                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">



                                <Button Grid.Column="0"



                                        Text="👤 User"



                                        Command="{Binding SelectUserRoleCommand}"



                                        CommandParameter="User"



                                        BackgroundColor="{Binding RoleEmployeeBgColor}"



                                        TextColor="{Binding RoleEmployeeTextColor}"



                                        FontAttributes="Bold"



                                        FontSize="11"



                                        CornerRadius="8"



                                        Padding="0"



                                        HeightRequest="36" />







                                <Button Grid.Column="1"



                                        Text="👔 Manager"



                                        Command="{Binding SelectUserRoleCommand}"



                                        CommandParameter="Manager"



                                        BackgroundColor="{Binding RoleManagerBgColor}"



                                        TextColor="{Binding RoleManagerTextColor}"



                                        FontAttributes="Bold"



                                        FontSize="11"



                                        CornerRadius="8"



                                        Padding="0"



                                        HeightRequest="36" />







                                <Button Grid.Column="2"



                                        Text="👑 Admin"



                                        Command="{Binding SelectUserRoleCommand}"



                                        CommandParameter="Admin"



                                        BackgroundColor="{Binding RoleAdminBgColor}"



                                        TextColor="{Binding RoleAdminTextColor}"



                                        FontAttributes="Bold"



                                        FontSize="11"



                                        CornerRadius="8"



                                        Padding="0"



                                        HeightRequest="36" />



                            </Grid>



                        </VerticalStackLayout>







                        <!-- Full Name -->



                        <VerticalStackLayout Spacing="4">



                            <Label Text="Full Name *" FontSize="11" FontAttributes="Bold" TextColor="#334155" />



                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                                <Entry Text="{Binding NewUserName}"



                                       Placeholder="e.g. Sarah Connor"



                                       PlaceholderColor="#94A3B8"



                                       TextColor="#0F172A"



                                       FontSize="13" />



                            </Border>



                        </VerticalStackLayout>







                        <!-- Email Address -->



                        <VerticalStackLayout Spacing="4">



                            <Label Text="Email Address (Optional if phone entered)" FontSize="11" FontAttributes="Bold" TextColor="#334155" />



                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                                <Entry Text="{Binding NewUserEmail}"



                                       Placeholder="sarah@example.com"



                                       PlaceholderColor="#94A3B8"



                                       Keyboard="Email"



                                       TextColor="#0F172A"



                                       FontSize="13" />



                            </Border>



                        </VerticalStackLayout>







                        <!-- Phone Number -->



                        <VerticalStackLayout Spacing="4">



                            <Label Text="Phone Number (Optional if email entered)" FontSize="11" FontAttributes="Bold" TextColor="#334155" />



                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                                <Entry Text="{Binding NewUserPhone}"



                                       Placeholder="+1 (555) 000-0000"



                                       PlaceholderColor="#94A3B8"



                                       Keyboard="Telephone"



                                       TextColor="#0F172A"



                                       FontSize="13" />



                            </Border>



                        </VerticalStackLayout>







                        <!-- Password -->



                        <VerticalStackLayout Spacing="4">



                            <Label Text="Initial Password *" FontSize="11" FontAttributes="Bold" TextColor="#334155" />



                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">



                                    <Entry Grid.Column="0"



                                           Text="{Binding NewUserPassword}"



                                           Placeholder="Min 6 characters"



                                           PlaceholderColor="#94A3B8"



                                           IsPassword="{Binding IsNewUserPasswordHidden}"



                                           TextColor="#0F172A"



                                           FontSize="13"



                                           VerticalOptions="Center" />



                                    <Button Grid.Column="1"



                                            Text="{Binding NewUserPasswordToggleIcon}"



                                            Command="{Binding ToggleNewUserPasswordVisibilityCommand}"



                                            BackgroundColor="Transparent"



                                            TextColor="#64748B"



                                            FontSize="14"



                                            Padding="4,0"



                                            HeightRequest="36"



                                            WidthRequest="36"



                                            VerticalOptions="Center" />



                                </Grid>



                            </Border>



                        </VerticalStackLayout>







                        <!-- Address -->



                        <VerticalStackLayout Spacing="4">



                            <Label Text="Address (Optional)" FontSize="11" FontAttributes="Bold" TextColor="#334155" />



                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12,4">



                                <Entry Text="{Binding NewUserAddress}"



                                       Placeholder="City, Branch or Location"



                                       PlaceholderColor="#94A3B8"



                                       TextColor="#0F172A"



                                       FontSize="13" />



                            </Border>



                        </VerticalStackLayout>







                        <!-- Error Message -->



                        <Label Text="{Binding AddUserErrorMessage}"



                               TextColor="#EF4444"



                               FontSize="12"



                               IsVisible="{Binding HasAddUserError}" />







                        <!-- Action Buttons -->



                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,4,0,0">



                            <Button Grid.Column="0"



                                    Text="Cancel"



                                    Command="{Binding CloseAddUserModalCommand}"



                                    BackgroundColor="#F1F5F9"



                                    TextColor="#475569"



                                    FontAttributes="Bold"



                                    FontSize="13"



                                    CornerRadius="8"



                                    HeightRequest="40" />



                            <Button Grid.Column="1"



                                    Text="Create User"



                                    Command="{Binding CreateUserCommand}"



                                    IsEnabled="{Binding CanSaveUser}"



                                    BackgroundColor="#008069"



                                    TextColor="White"



                                    FontAttributes="Bold"



                                    FontSize="13"



                                    CornerRadius="8"



                                    HeightRequest="40" />



                        </Grid>



                    </VerticalStackLayout>



                </ScrollView>



            </Border>



        </Grid>





    <!-- Manage Accounts & Security Modal (Admin Only) -->

    <Grid Grid.RowSpan="2"

          IsVisible="{Binding IsManageAccountsModalVisible}"

          BackgroundColor="#80000000"

          ZIndex="100">

        <Border BackgroundColor="White"

                Stroke="#CBD5E1"

                StrokeThickness="1"

                StrokeShape="RoundRectangle 16"

                Margin="16,30"

                Padding="0"

                HorizontalOptions="Fill"

                VerticalOptions="Center"

                MaximumHeightRequest="560">

            <Border.Shadow>

                <Shadow Brush="#40000000" Offset="0,6" Radius="16" Opacity="0.3" />

            </Border.Shadow>

            <Grid RowDefinitions="Auto, Auto, *, Auto">

                <!-- Modal Header -->

                <Grid Grid.Row="0"

                      BackgroundColor="#008069"

                      Padding="16,12"

                      ColumnDefinitions="*, Auto">

                    <VerticalStackLayout Grid.Column="0" Spacing="2">

                        <Label Text="🛡️ Security &amp; Accounts"

                               TextColor="White"

                               FontAttributes="Bold"

                               FontSize="16" />

                        <Label Text="Manage and block/unblock managers and clients"

                               TextColor="#D1FAE5"

                               FontSize="12" />

                    </VerticalStackLayout>

                    <Button Grid.Column="1"

                            Text="✕"

                            Command="{Binding CloseManageAccountsModalCommand}"

                            BackgroundColor="Transparent"

                            TextColor="White"

                            FontSize="18"

                            WidthRequest="36"

                            HeightRequest="36"

                            Padding="0"

                            VerticalOptions="Center" />

                </Grid>



                <!-- Tabs: Managers | Clients -->

                <Grid Grid.Row="1"

                      ColumnDefinitions="*, *"

                      ColumnSpacing="10"

                      Margin="16,12,16,8">

                    <!-- Managers Tab Button -->

                    <Button Grid.Column="0"

                            Text="Managers"

                            Command="{Binding SelectManageAccountsTabCommand}"

                            CommandParameter="0"

                            BackgroundColor="{Binding ManagersTabBgColor}"

                            TextColor="{Binding ManagersTabTextColor}"

                            FontAttributes="Bold"

                            FontSize="13"

                            CornerRadius="8"

                            HeightRequest="38" />



                    <!-- Users (Customers) Tab Button -->

                    <Button Grid.Column="1"

                            Text="Users (Customers)"

                            Command="{Binding SelectManageAccountsTabCommand}"

                            CommandParameter="1"

                            BackgroundColor="{Binding UsersTabBgColor}"

                            TextColor="{Binding UsersTabTextColor}"

                            FontAttributes="Bold"

                            FontSize="13"

                            CornerRadius="8"

                            HeightRequest="38" />

                </Grid>



                <!-- Loading Indicator -->

                <ActivityIndicator Grid.Row="2"

                                   IsRunning="{Binding IsLoadingAccounts}"

                                   IsVisible="{Binding IsLoadingAccounts}"

                                   Color="#008069"

                                   WidthRequest="36"

                                   HeightRequest="36"

                                   HorizontalOptions="Center"

                                   VerticalOptions="Center" />



                <!-- Tab 0: Managers List -->

                <CollectionView Grid.Row="2"

                                IsVisible="{Binding IsManagersTabActive}"

                                ItemsSource="{Binding ManagedManagers}"

                                Margin="16,4,16,8"

                                EmptyView="No managers registered in system.">

                    <CollectionView.ItemTemplate>

                        <DataTemplate x:DataType="vm:ManagedAccountItem">

                            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Margin="0,4" Padding="12,10">

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">

                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="#111B21" LineBreakMode="TailTruncation" />

                                            <Border BackgroundColor="{Binding StatusBadgeColor}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="6,1" VerticalOptions="Center">

                                                <Label Text="{Binding StatusBadgeText}" TextColor="{Binding StatusBadgeTextColor}" FontSize="9" FontAttributes="Bold" />

                                            </Border>

                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#64748B" LineBreakMode="TailTruncation" />

                                    </VerticalStackLayout>



                                    <Button Grid.Column="1"

                                            Text="{Binding ActionBtnText}"

                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentsViewModel}}, Path=ToggleBlockManagerCommand}"

                                            CommandParameter="{Binding .}"

                                            BackgroundColor="{Binding ActionBtnColor}"

                                            TextColor="{Binding ActionBtnTextColor}"

                                            FontAttributes="Bold"

                                            FontSize="12"

                                            CornerRadius="6"

                                            HeightRequest="32"

                                            Padding="12,0"

                                            VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>



                <!-- Tab 1: Users (Customers) List with Search -->

                <Grid Grid.Row="2"

                      RowDefinitions="Auto, *"

                      IsVisible="{Binding IsUsersTabActive}"

                      Margin="16,4,16,8">

                    <!-- Search Bar -->

                    <Border Grid.Row="0"

                            Stroke="#CBD5E1"

                            StrokeThickness="1"

                            StrokeShape="RoundRectangle 8"

                            BackgroundColor="#F8FAFC"

                            Padding="8,2"

                            Margin="0,0,0,8">

                        <Grid ColumnDefinitions="Auto, *">

                            <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalOptions="Center" Margin="4,0" />

                            <Entry Grid.Column="1"

                                   Placeholder="Search customer by name or email..."

                                   Text="{Binding UserSearchText}"

                                   FontSize="13"

                                   TextColor="#1E293B"

                                   PlaceholderColor="#94A3B8"

                                   ClearButtonVisibility="WhileEditing" />

                        </Grid>

                    </Border>



                    <CollectionView Grid.Row="1"

                                    ItemsSource="{Binding ManagedUsers}"

                                    EmptyView="No customers found.">

                        <CollectionView.ItemTemplate>

                            <DataTemplate x:DataType="vm:ManagedAccountItem">

                                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Margin="0,4" Padding="12,10">

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">

                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                                <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="#111B21" LineBreakMode="TailTruncation" />

                                                <Border BackgroundColor="{Binding StatusBadgeColor}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="6,1" VerticalOptions="Center">

                                                    <Label Text="{Binding StatusBadgeText}" TextColor="{Binding StatusBadgeTextColor}" FontSize="9" FontAttributes="Bold" />

                                                </Border>

                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#64748B" LineBreakMode="TailTruncation" />

                                        </VerticalStackLayout>



                                        <Button Grid.Column="1"

                                                Text="{Binding ActionBtnText}"

                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepartmentsViewModel}}, Path=ToggleBlockUserCommand}"

                                                CommandParameter="{Binding .}"

                                                BackgroundColor="{Binding ActionBtnColor}"

                                                TextColor="{Binding ActionBtnTextColor}"

                                                FontAttributes="Bold"

                                                FontSize="12"

                                                CornerRadius="6"

                                                HeightRequest="32"

                                                Padding="12,0"

                                                VerticalOptions="Center" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Grid>



                <!-- Close Button -->

                <Button Grid.Row="3"

                        Text="Close"

                        Command="{Binding CloseManageAccountsModalCommand}"

                        BackgroundColor="#F1F5F9"

                        TextColor="#475569"

                        FontAttributes="Bold"

                        Margin="16,6,16,14"

                        HeightRequest="42"

                        CornerRadius="8" />

            </Grid>

        </Border>

    </Grid>

    </Grid>

</ContentPage>